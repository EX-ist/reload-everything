{
  "schemaVersion": 1,
  "id": "reload-everything",
  "version": "${version}",
  "name": "Reload Everything",
  "description": "Reload things with one click: restart the game process, reload a singleplayer world, reload resource packs.",
  "authors": ["Miro"],
  "license": "MIT",
  "icon": "assets/reload-everything/icon.png",
  "environment": "client",
  "contact": {
    "homepage": "https://github.com/EX-ist/reload-everything",
    "sources": "https://github.com/EX-ist/reload-everything",
    "issues": "https://github.com/EX-ist/reload-everything/issues"
  },
  "entrypoints": {
    "main": [
      "reload.everything.ReloadEverything"
    ],
    "client": [
      "reload.everything.client.ReloadEverythingClient"
    ],
    "modmenu": [
      "reload.everything.config.ModMenuIntegration"
    ],
    "preLaunch": [
      "reload.everything.ReloadEverythingPreLaunch"
    ]
  },
  "mixins": [
    "reload-everything.mixins.json",
    {
      "config": "reload-everything.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": ">=26.2.155"
  },
  "suggests": {
    "fastquit": "*",
    "modmenu": ">=20.0.3"
  }
}
